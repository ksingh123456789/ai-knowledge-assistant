# App
APP_NAME=AI Knowledge Assistant
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173

# PostgreSQL + pgvector
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_assistant

# OpenRouter
OPENROUTER_API_KEY=replace-with-your-new-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openrouter/free

# Local embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LangSmith - optional but recommended
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=replace-with-your-new-langsmith-key
LANGSMITH_PROJECT=fastapi-ai-assistant
